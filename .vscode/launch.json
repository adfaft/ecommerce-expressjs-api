{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/dist/bin/www",
            "outFiles": [
                "${workspaceFolder}/**/*.js"
            ]
        },
        {
            "name": "Debug Jasmine Tests",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/jasmine/bin/jasmine.js",
        },
        {
            "name": "Debug Jasmine Current File",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/jasmine/bin/jasmine.js",
            "args": [
                "--config=${workspaceFolder}/spec/support/jasmine.mjs",
                "${workspaceFolder}/${relativeFileDirname}/${fileBasenameNoExtension}.js"
            ],
            "preLaunchTask": "npm: build",
            "internalConsoleOptions": "openOnSessionStart",
            "outFiles": [
                "${workspaceRoot}/dist/**/*"
            ],
            "outputCapture": "std",
        },
    ]
}